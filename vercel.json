{
    "version": 2,
    "name": "sonnenhof-management-ui",
    "builds": [
        {
            "src": "package.json",
            "use": "@vercel/static-build",
            "config": { "distDir": "dist/sonnenhof-management-ui" }
        }
    ],
    "routes": [
        { "src": "/(.*)", "dest": "/index.html" }
    ]
}
