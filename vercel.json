{
    "version": 2,
    "name": "sonnenhof-management-ui",
    "builds": [
            {
                "src": "package.json",
                "use": "@vercel/static-build",
                "config": { "distDir": "dist/sonnenhof-management-ui/browser" }
            }
    ],
        "routes": [
        {
            "src": "/couchdb/(.*)",
            "dest": "http://admin:server-lukas@0.tcp.eu.ngrok.io:18846/sonnenhof_db/$1"
        },
        { "src": "^/(?!.*\\.[^/]+$)(.*)", "dest": "/index.html" }
    ]
}
